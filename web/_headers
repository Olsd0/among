# Cloudflare Pages 응답 보안 헤더 (www.amongpick.com, 11/08부터). GitHub Pages는 이 파일을 무시한다.
# 페이지별 세부 정책(CSP)은 각 HTML의 <meta>에 있고, 여기에는 meta로는 걸 수 없는 것만 둔다.
# 쿠팡 링크의 referrerpolicy 속성은 링크마다 따로 적용되므로 아래 Referrer-Policy와 충돌하지 않는다.
/*
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin

# 관리 화면: admin.html은 Cloudflare에서 /admin으로 이동하므로 둘 다 (admin.js·admin.css 포함)
/admin*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# 서비스 워커는 항상 새로 확인
/sw.js
  Cache-Control: no-cache

# 미리보기·기본 주소(among-xxx.pages.dev)는 검색에 올리지 않는다. 대표 주소는 www.amongpick.com
https://:project.pages.dev/*
  X-Robots-Tag: noindex
